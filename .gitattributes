# Normalize line endings: LF in the repo, auto-converted on checkout.
# Prevents the "LF will be replaced by CRLF" noise on Windows checkouts.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfiles — keep LF, avoid churn.
package-lock.json text eol=lf
