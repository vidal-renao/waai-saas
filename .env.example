# ============================================================
# WAAI SaaS — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# ---- Core: Supabase -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Core: App ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WAAI SaaS
# Platform owner email (receives critical alerts)
PLATFORM_OWNER_EMAIL=admin@yourdomain.com

# ---- AI: Anthropic (LLM — Fase 3+) -------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Model for sandbox and WhatsApp replies
# Fallback hardcoded in AnthropicClaudeProvider: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_QUALITY=claude-sonnet-4-6

# ---- AI: OpenAI (Embeddings — Fase 4) -----------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimensions must match vector(1536) in waai_knowledge_chunks
OPENAI_EMBEDDING_DIMENSIONS=1536

# ---- WhatsApp — Whapi.cloud (Fase 5, MVP provider) ----------
WHAPI_TOKEN=your-whapi-token
WHAPI_BASE_URL=https://gate.whapi.cloud
# Secret used to verify inbound webhook signatures from Whapi
WHAPI_WEBHOOK_SECRET=your-webhook-secret
# Provider selector: whapi | meta | mock
WHATSAPP_PROVIDER=whapi

# ---- WhatsApp — Meta Cloud API (Fase 5, production) ---------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Token used for webhook verification (GET hub.verify_token)
META_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
# System user access token for sending messages — SERVER ONLY
META_ACCESS_TOKEN=EAA...
# Graph API version used for Cloud API calls (default: v21.0)
META_GRAPH_API_VERSION=v21.0

# ---- Billing Readiness (Fase 8) — Stripe Checkout (Fase 9) --
# Leave empty in Fase 8. Activate in Fase 9 when enabling real checkout.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for each plan
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ---- Security ------------------------------------------------
# Used to encrypt WhatsApp access tokens at rest (32-byte hex string)
ENCRYPTION_KEY=32-byte-hex-string-here
# Used to sign internal API-to-API calls (e.g. health check endpoints)
INTERNAL_API_SECRET=your-internal-secret
# Used to authenticate cron job API calls — activate in Fase 9
CRON_SECRET=

# ---- Observability (Fase 8) ---------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Set to 'true' to enable debug logs in production (avoid unless debugging)
ENABLE_DEBUG_LOGS=false
# Sentry — leave empty to fully disable error reporting (no-op).
# SENTRY_DSN is server-side; NEXT_PUBLIC_SENTRY_DSN is exposed to the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during build (optional). Upload is skipped unless all three
# are set, so local/CI builds work without them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
