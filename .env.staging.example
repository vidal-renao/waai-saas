# ============================================================
# WAAI SaaS — Staging Environment Variables Template
# Copiar este fichero a .env.local y rellenar los valores reales.
# NUNCA commitear .env.local al repositorio.
# Este fichero (.env.staging.example) SÍ puede commitearse — no contiene secretos.
# ============================================================

# ---- Boot: Supabase -----------------------------------------
# Proyecto: waai-saas-staging
# Obtener desde: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Boot: App ----------------------------------------------
# Para desarrollo local usar http://localhost:3000
# Para staging usar la URL de Vercel: https://waai-saas-staging.vercel.app
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=WAAI SaaS Staging

# ---- AI: Anthropic (LLM) ------------------------------------
# Clave real requerida para que funcione el Sandbox y WhatsApp
ANTHROPIC_API_KEY=
# Haiku para operaciones rápidas (sandbox, WhatsApp replies)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Sonnet para generación de prompts y agent builder
ANTHROPIC_MODEL_QUALITY=claude-sonnet-4-6

# ---- AI: OpenAI (Embeddings RAG) ----------------------------
# Clave real requerida para procesar documentos de knowledge base
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Debe coincidir con vector(1536) en waai_knowledge_chunks
OPENAI_EMBEDDING_DIMENSIONS=1536

# ---- WhatsApp — STAGING: SIEMPRE mock -----------------------
# En staging NUNCA usar whapi ni meta. Usar mock.
WHATSAPP_PROVIDER=mock
WHAPI_TOKEN=
WHAPI_BASE_URL=
WHAPI_WEBHOOK_SECRET=

# ---- Security -----------------------------------------------
# Generar ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Resultado: cadena de 64 caracteres hexadecimales
ENCRYPTION_KEY=

# Generar INTERNAL_API_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# ---- Observability ------------------------------------------
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# ---- Future: Stripe (Fase 10 — NO activar en staging) -------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
BILLING_PROVIDER=

# ---- Future: Sentry (Fase 10 — NO activar en staging) -------
SENTRY_DSN=

# ---- Future: Cron (Fase 10 — NO activar en staging) ---------
CRON_SECRET=

# ---- Future: Meta Cloud API (NO activar en staging) ---------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
